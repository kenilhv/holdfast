ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional: the number that gets a text when the board flags a bill.
CONTROLLER_PHONE=
# Optional: keeps the signing key across deploys. Without it a new key is made at boot.
SIGNING_KEY_PEM=
# Needed to approve or override a flagged bill on the board. Anyone can reject.
DECIDE_KEY=
# Optional: your own email domains, skipped when reading From lines, so forwarding a bill does not flag you.
OWN_DOMAINS=baylineconstruction.example
# Optional: a cap on checks per hour, because the board is public.
MAX_CHECKS_PER_HOUR=60
