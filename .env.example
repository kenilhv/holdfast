ANTHROPIC_API_KEY=
FIRECRAWL_API_KEY=
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
# Optional: the number that gets a text when the board flags a bill.
CONTROLLER_PHONE=
# Optional: keeps the signing key across deploys. Without it a new key is made at boot.
SIGNING_KEY_PEM=
# Optional: a cap on checks per hour, because the board is public.
MAX_CHECKS_PER_HOUR=60
